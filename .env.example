# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요 (.env.local 은 git에 올라가지 않음)

# Supabase (브라우저 노출 OK)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LOGIN_EMAIL=

# Google Gemini API 키 (서버 전용: NEXT_PUBLIC_ 붙이지 말 것)
GEMINI_API_KEY=

# 자동 로그인용 비밀번호 (Supabase 계정 비밀번호와 같게, 6자 이상)
NEXT_PUBLIC_LOGIN_PASSWORD=
